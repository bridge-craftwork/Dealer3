# Cloudflare Pages response headers.
#
# Vite copies everything in `web/public/` into the build output verbatim, so
# this file lands at the root of the deploy where Pages looks for it.

/*
  X-Content-Type-Options: nosniff
  # A script can travel in the query string (`?script=`), and a script is the
  # user's own work. Never hand it to a third party via the referrer.
  Referrer-Policy: no-referrer

# COOP/COEP are what `SharedArrayBuffer` needs, and `SharedArrayBuffer` is what a
# threaded wasm build needs. **The site ships the threaded build**, so these are
# load-bearing rather than set ahead of time, and they are the reason this site
# is on Cloudflare Pages rather than GitHub Pages, which cannot send custom
# headers. Without them every run silently falls back to one thread — which the
# page says out loud, beside the engine version.
#
# They are not free: `require-corp` blocks cross-origin subresources that do not
# opt in via CORP/CORS. Everything this page loads is same-origin except what
# comes from raw.githubusercontent.com — the PBS scenario manifest and its .dlr
# scripts, and the solved-deal library's manifest and .zdd chunks. All of them
# arrive with `access-control-allow-origin: *` and
# `cross-origin-resource-policy: cross-origin`, so `fetch` in its default CORS
# mode is unaffected. Verified live under these headers, not assumed.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Vite content-hashes everything under `assets/` — the wasm binary, JS, CSS. A
# hashed name cannot mean different bytes, so it is safe to cache forever and
# repeat visits skip the engine download.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, so it must be revalidated or a deploy never reaches anyone holding
# the old one.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
