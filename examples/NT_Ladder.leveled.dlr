# alias: NTLadder
# level-types: hcp12_14, hcp15_17, hcp18_19, hcp20_21, hcp22_24
# level-target: even
# button-text: NT Ladder (Lev)
# scenario-title: --- NT Ladder (Lev)
# gib-works: true
# bba-works: true
# auction-filter: Auction.....\n[1-7]
# convention-card-ns: 21GF-DEFAULT
# convention-card-ew: 21GF-GIB

/*@chat
--- NT Ladder (Lev)
Practice balanced hand evaluation across the full NT opening range.
Five HCP ranges, leveled to:
• 12-14 HCP (20%) - Open 1 of a suit, then rebid 1NT
• 15-17 HCP (20%) - Standard 1NT opening
• 18-19 HCP (20%) - Too strong for 1NT, open 1x then rebid 2NT
• 20-21 HCP (20%) - Open 2NT
• 22-24 HCP (20%) - Open 2C then rebid 2NT
@chat*/

produce 5000
dealer south

# Balanced shape for South
balanced = shape(south, any 4333 + any 4432 + any 5332)

# Define HCP ranges
hcp12_14 = hcp(south) >= 12 and hcp(south) <= 14
hcp15_17 = hcp(south) >= 15 and hcp(south) <= 17
hcp18_19 = hcp(south) >= 18 and hcp(south) <= 19
hcp20_21 = hcp(south) >= 20 and hcp(south) <= 21
hcp22_24 = hcp(south) >= 22 and hcp(south) <= 24

### BEGIN GENERATED LEVELING ###
# Generated by scripts/level-scenario.py. Do not edit; edit the stock
# scenario and regenerate, or the two will disagree without saying so.
#
# stock sha256   5c44e96ba2a4545b
# measured over  100,000 deals, seed 1
#
# type        natural    target     keep
# hcp12_14    0.58367   0.20000   0.0220
# hcp15_17    0.29189   0.20000   0.0440
# hcp18_19    0.08006   0.20000   0.1610
# hcp20_21    0.03153   0.20000   0.4080
# hcp22_24    0.01285   0.20000   1.0000
#
# exactness      1.000  (full)
# acceptance     0.0643 of qualifying deals
# cost           about 93 deals dealt per deal kept
# precision      keeps set by hcp22_24, the rarest, seen 1,285 times (+-2.8%); expect the mix within +-0.55 points

roll = (rnd(1000) % 1000 + 1000) % 1000

level_hcp12_14 = hcp12_14 and roll < 22
level_hcp15_17 = hcp15_17 and roll < 44
level_hcp18_19 = hcp18_19 and roll < 161
level_hcp20_21 = hcp20_21 and roll < 408
level_hcp22_24 = hcp22_24
levelTheDeal = level_hcp12_14 or level_hcp15_17 or level_hcp18_19 or level_hcp20_21 or level_hcp22_24
### END GENERATED LEVELING ###

##### Now do it #####
condition
balanced and hcp(south) >= 12 and hcp(south) <= 24
and levelTheDeal

action printoneline,
average "1. 12-14 HCP" 100 * hcp12_14,
average "2. 15-17 HCP" 100 * hcp15_17,
average "3. 18-19 HCP" 100 * hcp18_19,
average "4. 20-21 HCP" 100 * hcp20_21,
average "5. 22-24 HCP" 100 * hcp22_24,

frequency "HCP South " (hcp(south), 12, 24),
