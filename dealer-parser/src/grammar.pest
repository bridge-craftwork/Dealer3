// Dealer constraint language grammar

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{
    ("#" ~ (!"\n" ~ ANY)*) |
    ("//" ~ (!"\n" ~ ANY)*) |
    ("/*" ~ (!"*/" ~ ANY)* ~ "*/")
}

// Top-level can be a dealer program with action blocks or simple statements
// Statements can be separated by newlines, semicolons, or commas (for action lists)
program = { SOI ~ (dealer_statement ~ ("\n" | ";" | ",")?)* ~ EOI }

// Dealer statement types
dealer_statement = {
    condition_stmt
    | produce_stmt
    | generate_stmt
    | action_stmt
    | dealer_stmt
    | vulnerable_stmt
    | title_stmt
    | seed_stmt
    | predeal_stmt
    | csvrpt_stmt
    | printrpt_stmt
    | pointcount_stmt
    | altcount_stmt
    | average_stmt
    | frequency_stmt
    | printes_stmt
    | printhands_stmt
    | print_stmt
    | assignment
    | expr
}

// Standalone action statements (can appear without "action" keyword)
average_stmt = { &kw_average ~ ^"average" ~ string_literal? ~ expr }
frequency_stmt = { &kw_frequency ~ ^"frequency" ~ string_literal? ~ "(" ~ expr ~ "," ~ literal ~ "," ~ literal ~ ")" }
// The parentheses matter: `~` binds tighter than `|`, so without them the
// guard would cover only the first alternative and `printewFoo` would still
// be swallowed while `printallQ` was fixed.
print_stmt = { &kw_print ~ (^"printall" | ^"printew" | ^"printpbn" | ^"printcompact" | ^"printoneline") }

// Action block keywords
condition_stmt = { &kw_condition ~ ^"condition" ~ expr }
produce_stmt = { &kw_produce ~ ^"produce" ~ literal }
generate_stmt = { &kw_generate ~ ^"generate" ~ literal }
action_stmt = { &kw_action ~ ^"action" ~ (action_component ~ ("," ~ action_component)*)? }
dealer_stmt = { &kw_dealer ~ ^"dealer" ~ compass }
vulnerable_stmt = { &kw_vulnerable ~ ^"vulnerable" ~ vulnerability }
// DealerV2_4 names the run in the script rather than on the command line.
// Same thing as `-T`, and the switch wins when both are given.
title_stmt = { &kw_title ~ ^"title" ~ string_literal }
// Also DealerV2_4's, and also a switch here: `-s` wins.
seed_stmt = { &kw_seed ~ ^"seed" ~ literal }
// One `predeal` may name more than one seat, as dealer.exe's does:
// `predealargs: predealarg | predealargs predealarg`, so
// `predeal north SAKQ south SJ32` sets both.
//
// What separates one seat from the next is that holdings within a seat are
// comma-separated and seats are not — the original's grammar is
// `holdings: HOLDING | holdings ',' HOLDING`. So the comma-list is matched
// greedily before another group is tried, and `predeal north S,HAKQ` stays one
// seat rather than reading the `S` as South.
predeal_stmt = { &kw_predeal ~ ^"predeal" ~ predeal_group+ }
predeal_group = { compass ~ predeal_card ~ ("," ~ predeal_card)* }
csvrpt_stmt = { &kw_csvrpt ~ ^"csvrpt" ~ "(" ~ csv_term ~ ("," ~ csv_term)* ~ ")" }
// The same list to stdout. `printrpt` has to be matched before `print`, or the
// `print` keyword swallows its first five letters — the reason the guard below
// lists the longer spelling first.
printrpt_stmt = { &kw_printrpt ~ ^"printrpt" ~ "(" ~ csv_term ~ ("," ~ csv_term)* ~ ")" }

// printes(expr | string, ...) - the original's formatted per-deal output.
printes_stmt = { &kw_printes ~ printes_spec }
// print(compass, ...) - hand records for the named seats, four to a page.
printhands_stmt = { &kw_print ~ printhands_spec }

// Script-defined point counts. Values run from the ace downwards; ranks not
// reached score nothing. The count of values is checked when the statement is
// built rather than here, so the message can say what the limit is.
pointcount_stmt = { &kw_pointcount ~ ^"pointcount" ~ literal+ }
altcount_stmt = { &kw_altcount ~ ^"altcount" ~ literal ~ literal+ }

// CSV terms for csvrpt
csv_term = {
    ^"deal" |
    side |
    compass |
    string_literal |
    expr
}

side = @{ ^"ns" | ^"ew" }

// Action components (can be comma-separated)
action_component = { average_spec | frequency_spec | printrpt_spec | printes_spec | printhands_spec | action_type }
average_spec = { ^"average" ~ string_literal? ~ expr }
// frequency "label" (expr, min, max) - parentheses with commas
frequency_spec = { ^"frequency" ~ string_literal? ~ "(" ~ expr ~ "," ~ literal ~ "," ~ literal ~ ")" }

printes_spec = { ^"printes" ~ "(" ~ es_term ~ ("," ~ es_term)* ~ ")" }
printrpt_spec = { ^"printrpt" ~ "(" ~ csv_term ~ ("," ~ csv_term)* ~ ")" }
printhands_spec = { ^"print" ~ "(" ~ compass ~ ("," ~ compass)* ~ ")" }

// A `printes` item. `newline` is a token in its own right, because the
// original's lexer does not read escapes inside quotes: `"\n"` there is a
// backslash and an `n`, and a real newline is written as a bare `\n` in the
// list. Verified against the reference binary rather than assumed.
es_term = { string_literal | newline | expr }
newline = @{ "\\n" }

action_type = @{
    ^"printall" | ^"printew" | ^"printpbn" | ^"printcompact" | ^"printoneline"
}

// Dealer position (compass)
compass = @{
    (^"north" | ^"south" | ^"east" | ^"west") ~ !(ASCII_ALPHANUMERIC | "_")
    | (^"n" | ^"s" | ^"e" | ^"w") ~ !(ASCII_ALPHANUMERIC | "_")
}

// Vulnerability values
// The boundary is what stops `vulnerable ewer` being read as `vulnerable ew`
// with a stray `er` after it, which dealer.exe calls a syntax error.
vulnerability = @{
    (^"none" | ^"ns" | ^"ew" | ^"all") ~ !(ASCII_ALPHANUMERIC | "_")
}

// Variable assignment - uses assign_ident which allows single letters like s, n, e, w
assignment = { assign_ident ~ "=" ~ expr }

// Identifier for left side of assignment (allows single letters that would otherwise match positions)
assign_ident = @{ !reserved_unsupported ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

// Top-level constraint expression (for backward compatibility)
constraint = { SOI ~ expr ~ EOI }

// Expressions with operator precedence
// Ternary has lowest precedence
expr = { ternary }

ternary = { logical_or ~ ("?" ~ logical_or ~ ":" ~ ternary)? }

logical_or = { logical_and ~ (or_op ~ logical_and)* }
logical_and = { logical_not ~ (and_op ~ logical_not)* }
logical_not = { not_op ~ logical_not | comparison }

// Logical operator keywords
// Use @{} atomic rules with negative lookahead to ensure keywords are not part of a variable name
// e.g., "notNT" should be parsed as a variable, not "not" followed by "NT"
or_op = { "||" | or_keyword }
and_op = { "&&" | and_keyword }
not_op = { "!" | not_keyword }

or_keyword = @{ ^"or" ~ !(ASCII_ALPHANUMERIC | "_") }
and_keyword = @{ ^"and" ~ !(ASCII_ALPHANUMERIC | "_") }
not_keyword = @{ ^"not" ~ !(ASCII_ALPHANUMERIC | "_") }

// Chained comparisons: a==b==c means (a==b) && (b==c)
comparison = { additive ~ (cmp_op ~ additive)* }
additive = { multiplicative ~ (add_op ~ multiplicative)* }
multiplicative = { unary ~ (mul_op ~ unary)* }
// Unary operators: negation (-) and logical not (!/not)
// Both have the same (high) precedence, so 100 * not x = 100 * (not x)
unary = { "-" ~ unary | not_op ~ unary | primary }

primary = _{
    function_call  // Must be first to parse function(args)
    | paren_expr
    | shape_pattern
    | card
    | suit  // Suit keywords (spades, hearts, etc) as standalone values
    | denomination_word  // notrump/notrumps, as the number 4
    | position
    | literal
    | ident  // Variable references (must be last to avoid conflicts)
}

paren_expr = { "(" ~ expr ~ ")" }

// Function calls: hcp(north), hearts(south,spades), hascard(south,AS)
function_call = { function_name ~ "(" ~ expr ~ ("," ~ expr)* ~ ")" }

// Longest spelling first, always. `function_call` is `function_name ~ "("`, and
// PEG does not retry an alternation once a branch has matched: `hcp` ahead of
// `hcps` would match three letters of `hcps(`, fail on the `(`, and fall all the
// way through to `ident`. The original grammar knew this for the suit names
// ("must be before singular"); tests/vocabulary_matches_grammar.rs now enforces
// it for every pair.
function_name = @{
    "controls" | "control"
    | "hascard" | "hcps" | "hcp"
    | "losers" | "loser"
    | "shape" | "quality" | "cccc" | "score"
    | "tens" | "ten"
    | "jacks" | "jack"
    | "queens" | "queen"
    | "kings" | "king"
    | "aces" | "ace"
    | "top2" | "top3" | "top4" | "top5" | "c13"
    | "pt0" | "pt1" | "pt2" | "pt3" | "pt4" | "pt5" | "pt6" | "pt7" | "pt8" | "pt9"
    | "tricks" | "trick" | "dds"
    | "imps" | "imp"
    | "rnd"
    | "hearts" | "heart"
    | "spades" | "spade"
    | "diamonds" | "diamond"
    | "clubs" | "club"
}

// Comparison operators
cmp_op = {
    "==" | "!=" | "<=" | ">=" | "<" | ">"
}

// Arithmetic operators
add_op = { "+" | "-" }
mul_op = { "*" | "/" | "%" }

// The original's spelling of the fourth denomination. dealer.exe resolves the
// token to the literal 4 in its grammar —
//     TRICKS '(' compass ',' NOTRUMPS ')'  { newtree (TRT_TRICKS, NIL, NIL, $3, 4); }
// — and dealer3 already numbers strains 0=C, 1=D, 2=H, 3=S, 4=NT for both
// `tricks` and `score`, so the same resolution works here.
//
// This is more permissive than the original, which accepts the word only as an
// argument to `tricks`. Restricting it that way would mean per-function argument
// rules; being a plain value everywhere is the deliberate trade.
denomination_word = @{ (^"notrumps" | ^"notrump") ~ !(ASCII_ALPHANUMERIC | "_") }

// Positions at the bridge table
// Use word boundary: must not be followed by alphanumeric or underscore
// The trailing `!call_open` catches the same trap as `ident`: without it
// `north(x) >= 1` parses as the position `north` and then a second statement.
position = @{
    ((^"north" | ^"south" | ^"east" | ^"west") ~ !(ASCII_ALPHANUMERIC | "_")
    | (^"n" | ^"s" | ^"e" | ^"w") ~ !(ASCII_ALPHANUMERIC | "_"))
    ~ !call_open
}

// Suit names (for functions like losers(north, spades))
// Use negative lookahead to ensure:
// - not followed by '(' (which would be a function call like spades())
// - not followed by alphanumeric (which would be a variable like spadeFit)
suit = @{
    (^"spades" | ^"hearts" | ^"diamonds" | ^"clubs") ~ !(ASCII_ALPHANUMERIC | "(")
}

// Integer literals
literal = @{ "-"? ~ ASCII_DIGIT+ }

// String literals (for average labels)
string_literal = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

// Card names for hascard function: AS, KH, 2C (rank + suit)
card = @{
    rank ~ suit_char
}

// Card names for predeal: SA, HKQ, DT62, C95, or just S/H/D/C (suit + zero or more ranks)
// dealer.exe predeal uses suit-first format: SA = Ace of Spades, ST62 = Spades T-6-2
// A suit alone (e.g., "S") means no cards specified for that suit (placeholder/void)
predeal_card = @{
    suit_char ~ rank*
}

rank = { "A" | "K" | "Q" | "J" | "T" | "9" | "8" | "7" | "6" | "5" | "4" | "3" | "2" }
suit_char = { "S" | "H" | "D" | "C" }

// A statement keyword, and nothing longer.
//
// Each `*_stmt` rule opens with `&kw_x`, a predicate: it checks that the
// keyword ends here rather than running on into an identifier, consumes
// nothing and — being a predicate — produces no pair, so `parser.rs` sees the
// same shape it always did.
//
// The boundary cannot go in the statement rule directly. Those rules are not
// atomic, so pest inserts implicit whitespace between every pair of elements:
// `dealer ~ !(ALNUM) ~ compass` consumes the space first and then tests the
// `s` of `south`, rejecting every valid statement. Hence a separate atomic
// rule, checked ahead of the keyword rather than after it.
//
// Without these, a statement rule eats the front of any variable named after
// it. Some of that was loud — `conditionMet = 1` was a parse error — and some
// was not: `action` and the `print*` statements take no required argument, so
// `actionList = 1` parsed as an empty `action` plus an assignment to `List`,
// and the script then generated ten million deals, matched none, and exited 0.
kw_condition  = @{ ^"condition"  ~ !(ASCII_ALPHANUMERIC | "_") }
kw_produce    = @{ ^"produce"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_generate   = @{ ^"generate"   ~ !(ASCII_ALPHANUMERIC | "_") }
kw_action     = @{ ^"action"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_dealer     = @{ ^"dealer"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_title      = @{ ^"title"      ~ !(ASCII_ALPHANUMERIC | "_") }
kw_seed       = @{ ^"seed"       ~ !(ASCII_ALPHANUMERIC | "_") }
kw_vulnerable = @{ ^"vulnerable" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_predeal    = @{ ^"predeal"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_csvrpt     = @{ ^"csvrpt"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_printrpt   = @{ ^"printrpt"   ~ !(ASCII_ALPHANUMERIC | "_") }
kw_pointcount = @{ ^"pointcount" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_altcount   = @{ ^"altcount"   ~ !(ASCII_ALPHANUMERIC | "_") }
kw_average    = @{ ^"average"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_frequency  = @{ ^"frequency"  ~ !(ASCII_ALPHANUMERIC | "_") }
kw_printes    = @{ ^"printes"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_print      = @{ (^"printall" | ^"printew" | ^"printpbn" | ^"printcompact" | ^"printoneline" | ^"print") ~ !(ASCII_ALPHANUMERIC | "_") }

// Words that introduce a statement. Kept out of bare-identifier position: a
// malformed statement otherwise backtracks into `expr` and parses as bare
// identifiers the evaluator ignores, so `dealer soudfsfd` was silently accepted
// where dealer.exe reports "syntax error".
//
// Referenced only from `ident`, which is atomic, so no implicit whitespace is
// inserted before the boundary lookahead. The trailing `!(ALNUM | "_")` keeps
// names like `conditionMet` from matching the bare keyword.
statement_keyword = @{
    kw_condition | kw_produce | kw_generate | kw_action | kw_dealer
    | kw_vulnerable | kw_predeal | kw_csvrpt | kw_printrpt | kw_average | kw_frequency
    | kw_pointcount | kw_altcount | kw_printes | kw_print | kw_title | kw_seed
}

// Words the original dealer accepts that dealer3 does not implement.
//
// Kept out of identifier position so they fail loudly. Without this they are
// read as variables, and a variable is an ordinary expression, so a whole
// statement quietly turns into something else: `condition control(north) >= 5`
// became the bare expression `control` followed by `(north) >= 5`, the last of
// which is the one that runs. It produced no deals, no error and exit 0.
//
// Longest first: PEG commits to the first alternative that matches, so
// `^"notrump"` ahead of `^"notrumps"` would match the first seven letters of
// `notrumps` and then fail the word boundary without retrying.
//
// Held to `vocabulary::NOT_SUPPORTED` by tests/vocabulary_matches_grammar.rs.
reserved_unsupported = @{
    (^"evalcontract")
    ~ !(ASCII_ALPHANUMERIC | "_")
}

// An identifier immediately followed by "(" is a call to something that is not
// a function, since `function_call` is tried first and failed. Rejecting it here
// is what turns `control(north)` from two statements into a syntax error.
call_open = _{ (" " | "\t")* ~ "(" }

// Identifiers (for variables)
// Allow any alphanumeric identifier - the parser will try more specific rules first
// Variables like "spadeFit" or "heartCount" must be allowed even though they start with keywords
ident = @{
    !statement_keyword ~ !reserved_unsupported
    ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*
    ~ !call_open
}

// Shape patterns: any 4333 + 54xx - any 0xxx
// Spaces can act as implicit "+" (addition) between shape specs
shape_pattern = { shape_spec ~ ((shape_op)? ~ shape_spec)* }

shape_spec = { (shape_any ~ shape_digits_any) | shape_digits_marked }

shape_any = { ^"any" }

shape_op = { "+" | "-" }

// Shape digits after "any" keyword - can be pure digits (any disambiguates)
shape_digits_any = @{ shape_char ~ shape_char ~ shape_char ~ shape_char }

// Shape digits without "any" - must have %s prefix OR contain wildcards
shape_digits_marked = @{
    ("%s" ~ shape_len ~ shape_len ~ shape_len ~ shape_len)
    | (shape_char_with_wildcard ~ shape_char ~ shape_char ~ shape_char)
    | (shape_char ~ shape_char_with_wildcard ~ shape_char ~ shape_char)
    | (shape_char ~ shape_char ~ shape_char_with_wildcard ~ shape_char)
    | (shape_char ~ shape_char ~ shape_char ~ shape_char_with_wildcard)
}

shape_char = { shape_len | "x" | "X" }
shape_char_with_wildcard = { "x" | "X" }

// A suit length as one character, so a distribution stays four characters wide.
// Ten to thirteen carry on past `9` into `:;<=`, which is the original's own
// convention — `insertshape` fills a wildcard with `13-ccount+'0'` and says in
// a comment that it "could go above '9'". It never lets a script type one,
// having no need to; the FD shape expander does, since `5+Mxxx` means a ten-card
// major as much as a five-card one.
shape_len = { ASCII_DIGIT | ":" | ";" | "<" | "=" }
